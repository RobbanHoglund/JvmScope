{
  "name": "jvmscope-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "npm test && vite build",
    "build:slim": "npm test && vite build --mode slim",
    "build:pages": "npm test && node ../scripts/build-pages.mjs",
    "test:pages:ui": "playwright test --config test/tls/playwright.pages.config.js",
    "preview:pages": "node ../scripts/preview-pages.mjs",
    "test:slim:ui": "playwright test --config test/tls/playwright.slim.config.js",
    "build:ci": "npm run build && playwright test --config test/tls/playwright.config.js",
    "build:all": "npm run build",
    "dev": "vite",
    "test": "npm run test:tda && npm run test:tls && npm run test:launcher && npm run test:pages && npm run test:jvm-samples",
    "test:pages": "node --test ../scripts/pages.test.mjs",
    "test:jvm-samples": "node --test ../scripts/jvm-samples.test.mjs && node ../scripts/jvm-samples.mjs check",
    "test:launcher": "node --test ../scripts/local-dev.test.mjs",
    "test:tda": "npm run test:tda:unit && npm run test:tda:integration",
    "test:tda:ui": "playwright test --config test/tls/playwright.config.js --grep TDA",
    "test:tls": "npm run test:tls:unit && npm run test:tls:integration",
    "test:tls:unit": "node --test test/tls/*.test.js",
    "test:tls:integration": "node --test test/tls/integration/*.test.js",
    "test:tls:ui": "vite build && playwright test --config test/tls/playwright.config.js",
    "test:tls:all": "npm run test:tls && npm run test:tls:ui",
    "test:tda:unit": "node --test test/tda/*.test.js",
    "test:tda:integration": "node --test test/tda/integration/*.test.js"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "vite": "^8.0.0"
  }
}
