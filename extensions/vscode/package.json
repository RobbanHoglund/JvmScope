{
  "name": "jvmscope",
  "displayName": "JvmScope — Java Threads, TLS & GC",
  "description": "Analyze Java thread dumps, JSSE TLS logs and garbage collection locally. Visualize deadlocks and GC timelines, compare snapshots and investigate evidence.",
  "version": "2.0.0",
  "publisher": "RobbanHoglund",
  "icon": "icon.png",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/RobbanHoglund/JvmScope.git",
    "directory": "extensions/vscode"
  },
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "keywords": [
    "java",
    "jvm",
    "thread dump",
    "deadlock",
    "tls",
    "ssl",
    "jsse"
  ],
  "main": "./src/extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "jvmscope.openGc",
        "title": "Open Java Garbage Collection Log Analyzer",
        "category": "JvmScope",
        "icon": { "light": "resources/gc-light.svg", "dark": "resources/gc-dark.svg" }
      },
      {
        "command": "jvmscope.analyzeGcLog",
        "title": "Analyze as Java GC Log",
        "category": "JvmScope",
        "icon": { "light": "resources/gc-light.svg", "dark": "resources/gc-dark.svg" }
      },
      {
        "command": "jvmscope.openTda",
        "title": "Open Java Thread Dump Analyzer",
        "category": "JvmScope",
        "icon": {
          "light": "resources/threads-light.svg",
          "dark": "resources/threads-dark.svg"
        }
      },
      {
        "command": "jvmscope.openTls",
        "title": "Open Java TLS Log Analyzer",
        "category": "JvmScope",
        "icon": {
          "light": "resources/tls-light.svg",
          "dark": "resources/tls-dark.svg"
        }
      },
      {
        "command": "jvmscope.openKnowledge",
        "title": "Open Knowledge Base",
        "category": "JvmScope",
        "icon": "$(book)"
      },
      {
        "command": "jvmscope.analyzeThreadDump",
        "title": "Analyze as Java Thread Dump",
        "category": "JvmScope",
        "icon": {
          "light": "resources/threads-light.svg",
          "dark": "resources/threads-dark.svg"
        }
      },
      {
        "command": "jvmscope.analyzeTlsLog",
        "title": "Analyze as Java TLS Log",
        "category": "JvmScope",
        "icon": {
          "light": "resources/tls-light.svg",
          "dark": "resources/tls-dark.svg"
        }
      },
      {
        "command": "jvmscope.openAnalysis",
        "title": "Open Analysis Sidebar",
        "category": "JvmScope"
      }
    ],
    "menus": {
      "explorer/context": [
        { "command": "jvmscope.analyzeGcLog", "when": "!explorerResourceIsFolder", "group": "jvmscope@3" },
        {
          "command": "jvmscope.analyzeThreadDump",
          "when": "!explorerResourceIsFolder",
          "group": "jvmscope@1"
        },
        {
          "command": "jvmscope.analyzeTlsLog",
          "when": "!explorerResourceIsFolder",
          "group": "jvmscope@2"
        }
      ],
      "editor/title": [
        { "command": "jvmscope.openGc", "group": "navigation@22" },
        {
          "command": "jvmscope.openTda",
          "group": "navigation@20"
        },
        {
          "command": "jvmscope.openTls",
          "group": "navigation@21"
        }
      ],
      "editor/title/context": [
        { "command": "jvmscope.analyzeGcLog", "group": "jvmscope@3" },
        {
          "command": "jvmscope.analyzeThreadDump",
          "group": "jvmscope@1"
        },
        {
          "command": "jvmscope.analyzeTlsLog",
          "group": "jvmscope@2"
        }
      ],
      "view/title": [
        { "command": "jvmscope.openGc", "when": "view == jvmscope.analysis", "group": "navigation@3" },
        { "command": "jvmscope.openGc", "when": "view == jvmscope.analysis", "group": "1_analyzers@3" },
        {
          "command": "jvmscope.openTda",
          "when": "view == jvmscope.analysis",
          "group": "navigation@1"
        },
        {
          "command": "jvmscope.openTls",
          "when": "view == jvmscope.analysis",
          "group": "navigation@2"
        },
        {
          "command": "jvmscope.openTda",
          "when": "view == jvmscope.analysis",
          "group": "1_analyzers@1"
        },
        {
          "command": "jvmscope.openTls",
          "when": "view == jvmscope.analysis",
          "group": "1_analyzers@2"
        },
        {
          "command": "jvmscope.openKnowledge",
          "when": "view == jvmscope.analysis",
          "group": "2_help@1"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "jvmscope",
          "title": "JvmScope",
          "icon": "resources/activity.svg"
        }
      ]
    },
    "views": {
      "jvmscope": [
        {
          "id": "jvmscope.analysis",
          "name": "JvmScope Analyses",
          "contextualTitle": "JvmScope"
        }
      ]
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-vscode.mjs",
    "test": "node --test test/*.test.cjs",
    "test:integration": "node test/run-integration.cjs",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies --out ../../build/vscode/"
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0"
  },
  "preview": false
}
